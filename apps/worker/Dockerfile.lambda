# Lambda container image for the VerifyPass verification worker.
# Build from the REPO ROOT (needs workspace packages):
#   docker build -f apps/worker/Dockerfile.lambda -t verifypass-worker .
#
# ONNX models must be fetched before building (baked into the image so cold
# starts don't download): npm run models:fetch

FROM public.ecr.aws/lambda/nodejs:20

# Workspace layout — worker + its shared deps
COPY package.json package-lock.json ${LAMBDA_TASK_ROOT}/
COPY packages/shared ${LAMBDA_TASK_ROOT}/packages/shared
COPY apps/worker ${LAMBDA_TASK_ROOT}/apps/worker
COPY apps/api/src/services/jobService.js ${LAMBDA_TASK_ROOT}/apps/api/src/services/jobService.js
COPY apps/api/src/lib/db.js ${LAMBDA_TASK_ROOT}/apps/api/src/lib/db.js
COPY apps/api/prisma ${LAMBDA_TASK_ROOT}/apps/api/prisma

# Install production deps for the worker workspace (x86_64 Lambda runtime —
# native binaries onnxruntime-node/sharp resolve for linux-x64 here, NOT on
# your Mac). tesseract.js is the optional OCR dep; aws sdks power S3/SQS.
RUN cd ${LAMBDA_TASK_ROOT} && \
    npm install --omit=dev --workspaces --include-workspace-root=false \
      --workspace=apps/worker --workspace=packages/shared && \
    npm install --no-save @aws-sdk/client-s3 @aws-sdk/client-sqs tesseract.js && \
    npx prisma generate --schema apps/api/prisma/schema.prisma

# Environment expected at runtime (set on the function, not baked in):
#   DATABASE_URL, EVIDENCE_BACKEND=s3, S3_BUCKET, S3_REGION[, S3_ENDPOINT],
#   QUEUE_BACKEND=sqs, SQS_QUEUE_URL, EVIDENCE_ENCRYPTION_KEY,
#   SDK_TOKEN_SECRET, VP_PROVIDER=onnx, ONNX_MODELS_DIR, PROVIDER_MODEL_VERSION,
#   NODE_ENV=production

CMD ["apps/worker/lambda.handler"]
