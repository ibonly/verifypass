Options -Indexes -MultiViews
DirectoryIndex index.html
AddType application/wasm .wasm
AddType text/javascript .mjs
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/octet-stream text/javascript
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  # Public SDK assets (models, ONNX Runtime WASM, CDN bundles) are loaded
  # cross-origin by integrating sites. They are static and credential-free.
  <If "%{REQUEST_URI} =~ m#^/(models|sdk-assets|sdk)/#">
    Header set Access-Control-Allow-Origin "*"
    Header set Cross-Origin-Resource-Policy "cross-origin"
  </If>
  # Versioned path: never changes. Models keep their name across updates
  # (checksum-pinned in the SDK), so they revalidate daily.
  <If "%{REQUEST_URI} =~ m#^/sdk-assets/ort/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <If "%{REQUEST_URI} =~ m#^/models/#">
    Header set Cache-Control "public, max-age=86400"
  </If>
  <If "%{REQUEST_URI} =~ m#^/sdk/#">
    Header set Cache-Control "public, max-age=300"
  </If>
</IfModule>
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^(?:assets|models|sdk-assets|sdk)/ - [R=404,L]
RewriteRule ^ index.html [L]