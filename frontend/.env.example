# VerifyPass — local / in-house environment (single source of truth).
# Loaded by the API, the worker, and the Prisma CLI. Gitignored.

# ── Database (local MySQL via Herd; root has no password over the socket) ──
DATABASE_URL="mysql://root@127.0.0.1:3306/verifypass"

# ── Secrets (generated with crypto.randomBytes) ──
SDK_TOKEN_SECRET="c7ba60f777070e8a1485568e24d191dd557c81ba43e025b0"
AUTH_TOKEN_SECRET="f6ac874ed073797e13f8d32b54adb19ffa7bf9e4cee438e3"
EVIDENCE_ENCRYPTION_KEY="d670bbd4ed3942cc0156560d265012e591d01ea416a17c5b5d00d876487d0050"

# ── Evidence storage (outside any public web root) ──
EVIDENCE_DIR="/Volumes/ibonly/Claud/Liveness Check App/verifypass/.evidence-store"

# ── Runtime ──
NODE_ENV=development
PORT=3000
SESSION_TTL_MINUTES=30
HOSTED_BASE_URL="http://localhost:5174"

# ── Worker ──
WORKER_POLL_MS=2000

# ── Verification provider: "onnx" (server-side, no license/Docker) or "faceplugin" ──
VP_PROVIDER=onnx
ONNX_MATCH_THRESHOLD=0.6

# ── Faceplugin on-premise Docker services (only if VP_PROVIDER=faceplugin) ──
FACEPLUGIN_LIVENESS_URL="http://127.0.0.1:8888"
FACEPLUGIN_FACE_URL="http://127.0.0.1:8889"
# Leave FACEPLUGIN_IDOCR_URL unset unless the ID-Card-Recognition service is deployed.
# FACEPLUGIN_IDOCR_URL="http://127.0.0.1:8890"
FACEPLUGIN_MATCH_THRESHOLD=0.6
FACEPLUGIN_TIMEOUT_MS=20000


# ── Cloudinary (optional) — visual evidence mirror for review/comparison ──
# When set, each captured image is also uploaded to Cloudinary with a filename
# that reflects the required action (e.g. liveness_smile_<ts>). Uploads are
# best-effort and never block verification. Either set CLOUDINARY_URL, or the
# three CLOUDINARY_CLOUD_NAME/API_KEY/API_SECRET values.
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME="ibonly"
CLOUDINARY_API_KEY="424911665345686"
CLOUDINARY_API_SECRET="uRQ-v31go_BR6_O2xvPlbfXtx4Y"
CLOUDINARY_FOLDER="verifypass"