# ---- Server-only (never prefixed with VITE_, never sent to the browser) ----
# Your VerifyPass secret key. Used by the session endpoints in server/ to
# create sessions and read verified results.
VERIFYPASS_SECRET_KEY=vp_sec_test_REPLACE_ME
# VerifyPass API origin. Defaults to the live test API when omitted.
# VERIFYPASS_API_BASE=https://uybb6wv27prwyijtkcteovvvke0hfkqw.lambda-url.us-east-2.on.aws
# Port for `npm start` (production server).
# PORT=8080

# ---- Public browser configuration (embedded in the JS bundle) ----
# Optional. Leave unset to use token-only auth: the sdkToken returned by your
# server already tells the widget which API to call.
# VITE_VP_PUBLIC_KEY=vp_pub_test_REPLACE_ME
# Leave unset to relay the widget's API calls through this app's origin
# (server/sdkProxy.mjs). Set it only if VerifyPass has added your origin to
# its CORS allowlist and you want the widget to call the API directly.
# VITE_VP_API_BASE=https://api.example.com
VITE_VP_FACE_MODEL_URL=/models/fr_detect.onnx
VITE_VP_LANDMARK_MODEL_URL=/models/fr_landmark.onnx
