# Lambda container image for the VerifyPass verification worker.
# Build from the backend/ folder (fetch models first: node scripts/fetch-models.js):
#   docker build -f Dockerfile.worker -t verifypass-worker .

FROM public.ecr.aws/lambda/nodejs:22@sha256:b9dd86c58dc96886e635d317aaef3b80984630afb7850b97b2e19d043d122042

COPY . ${LAMBDA_TASK_ROOT}/

# onnxruntime-node / sharp resolve their linux-x64 binaries in this image.
RUN cd ${LAMBDA_TASK_ROOT} && \
    npm ci && \
    ./node_modules/.bin/prisma generate --schema prisma/schema.prisma && \
    npm prune --omit=dev

# Runtime env: DATABASE_URL, EVIDENCE_BACKEND=s3, S3_BUCKET, S3_REGION,
# QUEUE_BACKEND=db, EVIDENCE_ENCRYPTION_KEY, SDK_TOKEN_SECRET,
# VP_PROVIDER=onnx, PROVIDER_MODEL_VERSION, NODE_ENV=production

CMD ["worker.lambda.handler"]
