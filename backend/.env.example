# MySQL connection (cPanel: create DB + user in MySQL Databases)
DATABASE_URL="mysql://user:password@localhost:3306/verifypass"

# Production refuses to boot with missing/change-me/dev-only secrets.
# Use independent 32+ character random values for token secrets.
SDK_TOKEN_SECRET="change-me-random-32-chars-minimum"
AUTH_TOKEN_SECRET="change-me-random-32-chars-minimum-2"
# 64 hex characters, e.g. `openssl rand -hex 32`
EVIDENCE_ENCRYPTION_KEY="change-me-64-hex-chars-aes-256-key"

# Evidence directory — MUST be outside public_html
EVIDENCE_DIR="/home/cpaneluser/verifypass-evidence"

HOSTED_BASE_URL="https://verify.verifypass.com"

# Public https origin of THIS API deployment. Embedded in SDK tokens so
# browser SDKs are self-locating — one value per environment (sandbox and
# production deployments each set their own). Required in production.
API_PUBLIC_URL="https://api.verifypass.com"

NODE_ENV=development
PORT=3000
SESSION_TTL_MINUTES=30
