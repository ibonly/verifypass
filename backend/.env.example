# VerifyPass — environment template. Copy to .env and fill in real values.
# Loaded by the API, the worker, and the Prisma CLI.

# ── Database (MongoDB) ──
# MongoDB — Prisma requires a REPLICA SET (Atlas always is; local: mongod --replSet rs0)
# Atlas: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/verifypass
DATABASE_URL="mongodb://127.0.0.1:27017/verifypass?replicaSet=rs0"
# Lambda + Atlas: cap the per-container pool or concurrency can exhaust the
# Atlas connection limit (M0 = 500). Append to the URL: &maxPoolSize=5

# ── Secrets ──
# Generate with:
#   node -e "const c=require('crypto');console.log(c.randomBytes(24).toString('hex'))"
SDK_TOKEN_SECRET="change-me-random-32-chars-minimum"
AUTH_TOKEN_SECRET="change-me-random-32-chars-minimum-2"
# 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EVIDENCE_ENCRYPTION_KEY="change-me-64-hex-chars-aes-256-key"

# ── Evidence storage (MUST be outside any public web root) ──
EVIDENCE_DIR="./.evidence-store"

# ── Runtime ──
NODE_ENV=development
PORT=3000
SESSION_TTL_MINUTES=30
HOSTED_BASE_URL="http://localhost:5174"

# ── Worker ──
WORKER_POLL_MS=2000

# ── Cloudinary (optional) — visual evidence mirror for review/comparison ──
# When set, each captured image is also uploaded to Cloudinary with a filename
# that reflects the required action (e.g. liveness_smile_<ts>). Uploads are
# best-effort and never block verification. Either set CLOUDINARY_URL, or the
# three CLOUDINARY_CLOUD_NAME/API_KEY/API_SECRET values.
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="verifypass"
# ── Verification provider ──
# "onnx"       = server-side ONNX models (onnxruntime-node) — no license/Docker
# "faceplugin" = Faceplugin on-prem Docker services (licensed)
VP_PROVIDER=onnx
ONNX_MATCH_THRESHOLD=0.6

# ── Faceplugin on-premise Docker services (only if VP_PROVIDER=faceplugin) ──
FACEPLUGIN_LIVENESS_URL="http://127.0.0.1:8888"
FACEPLUGIN_FACE_URL="http://127.0.0.1:8889"
# FACEPLUGIN_IDOCR_URL="http://127.0.0.1:8890"   # optional ID OCR service
FACEPLUGIN_MATCH_THRESHOLD=0.6
FACEPLUGIN_TIMEOUT_MS=20000

# ── Sanctions/PEP screening (CBN-aligned CDD; default OFF) ──
# SCREENING_BACKEND=none|webhook. webhook POSTs {fullName, customerReference}
# and expects {sanctions:bool, pep:bool, matches:[...]}. Fail-open, always
# recorded in rawResult.screening; a HIT escalates approved → manual_review.
SCREENING_BACKEND=none
# SCREENING_WEBHOOK_URL=https://screening.example.com/check
# SCREENING_WEBHOOK_TOKEN=
