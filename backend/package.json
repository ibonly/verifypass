{
  "name": "@verifypass/backend",
  "version": "0.1.0",
  "private": true,
  "main": "app.js",
  "scripts": {
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-mysql://user:password@localhost:3306/verifypass} prisma validate --schema prisma/schema.prisma",
    "worker": "node worker.js"
  },
  "dependencies": {
    "@prisma/client": "^5.16.0",
    "@verifypass/shared": "*",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sharp": "^0.33.5",
    "onnxruntime-node": "^1.19.2"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/client-lambda": "^3.600.0",
    "serverless-http": "^3.2.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^5.16.0",
    "supertest": "^7.0.0"
  },
  "description": "VerifyPass backend — API + verification worker as one Lambda-ready service"
}
