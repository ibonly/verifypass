// VerifyPass MVP schema (PRD §11 + queue/webhook/user tables) — MongoDB.
//
// MongoDB notes:
//  - ids are ObjectId strings (@default(auto())); no autoincrement.
//  - Prisma's MongoDB connector has no Decimal — scores are Float (they are
//    0..1 confidence values; Float precision is more than sufficient).
//  - No migrations on MongoDB: apply the schema with `prisma db push`
//    (creates collections + indexes). Prisma requires the server to be a
//    REPLICA SET (Atlas always is; local: mongod --replSet rs0).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  tenantUid      String    @unique @map("tenant_uid")
  companyName    String    @map("company_name")
  status         TenantStatus @default(sandbox)
  webhookUrl     String?   @map("webhook_url")
  webhookSecret  String?   @map("webhook_secret")
  allowedDomains Json?     @map("allowed_domains")
  settings       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  apiKeys  ApiKey[]
  sessions VerificationSession[]
  users    User[]

  @@map("tenants")
}

enum TenantStatus {
  sandbox
  active
  suspended
  disabled
}

model ApiKey {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String       @map("tenant_id") @db.ObjectId
  keyType   ApiKeyType   @map("key_type")
  isLive    Boolean      @default(false) @map("is_live")
  keyHash   String       @map("key_hash")
  prefix    String
  status    ApiKeyStatus @default(active)
  expiresAt DateTime?    @map("expires_at")
  createdAt DateTime     @default(now()) @map("created_at")
  revokedAt DateTime?    @map("revoked_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([prefix])
  @@index([tenantId])
  @@map("api_keys")
}

enum ApiKeyType {
  public
  secret
}

enum ApiKeyStatus {
  active
  revoked
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String?  @map("tenant_id") @db.ObjectId // null = platform super admin
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  mfaSecret    String?  @map("mfa_secret")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("users")
}

enum UserRole {
  super_admin
  tenant_admin
  compliance_reviewer
  developer
  auditor
}

model VerificationSession {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  sessionUid        String        @unique @map("session_uid")
  tenantId          String        @map("tenant_id") @db.ObjectId
  customerReference String?       @map("customer_reference")
  verificationType  String?       @map("verification_type")
  documentTypes     Json?         @map("document_types")
  callbackUrl       String?       @map("callback_url")
  metadata          Json?
  sdkTokenHash      String?       @map("sdk_token_hash")
  livenessChallenge Json?         @map("liveness_challenge")
  deviceFingerprint String?       @map("device_fingerprint")
  deviceMeta        Json?         @map("device_meta")
  clientIp          String?       @map("client_ip")
  // Biometric-processing consent (NDPA lawful basis; CBN-aligned CDD proof).
  // Set once by the SDK when the user accepts the consent screen.
  consentAt         DateTime?     @map("consent_at")
  consentMeta       Json?         @map("consent_meta") // {copyVersion, ip, userAgent}
  status            SessionStatus @default(created)
  riskLevel         RiskLevel?    @map("risk_level")
  decisionReason    Json?         @map("decision_reason")
  isLive            Boolean       @default(false) @map("is_live")
  expiresAt         DateTime?     @map("expires_at")
  completedAt       DateTime?     @map("completed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at")

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  results  VerificationResult[]
  evidence EvidenceFile[]
  reviews  ManualReviewNote[]

  @@index([tenantId, status])
  @@index([tenantId, customerReference])
  @@index([tenantId, deviceFingerprint])
  @@index([tenantId, clientIp])
  @@map("verification_sessions")
}

enum SessionStatus {
  created
  started
  submitted
  approved
  rejected
  manual_review
  expired
  failed
  abandoned
}

enum RiskLevel {
  low
  medium
  high
}

model VerificationResult {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  sessionId       String    @map("session_id") @db.ObjectId
  livenessScore   Float?    @map("liveness_score")
  livenessStatus  CheckStatus? @map("liveness_status")
  faceMatchScore  Float?    @map("face_match_score")
  faceMatchStatus MatchStatus? @map("face_match_status")
  documentStatus  DocStatus? @map("document_status")
  ocrConfidence   Float?    @map("ocr_confidence")
  extractedData   Json?     @map("extracted_data")
  rawResult       Json?     @map("raw_result")
  createdAt       DateTime  @default(now()) @map("created_at")

  session VerificationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("verification_results")
}

enum CheckStatus {
  passed
  failed
  review
}

enum MatchStatus {
  matched
  not_matched
  review
}

enum DocStatus {
  valid
  invalid
  review
}

model EvidenceFile {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId          String   @map("session_id") @db.ObjectId
  fileType           EvidenceType @map("file_type")
  label              String?
  storagePath        String   @map("storage_path")
  checksum           String?
  cloudinaryUrl      String?  @map("cloudinary_url")
  cloudinaryPublicId String?  @map("cloudinary_public_id")
  encrypted          Boolean  @default(true)
  retentionExpiresAt DateTime? @map("retention_expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  session VerificationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@index([retentionExpiresAt])
  @@map("evidence_files")
}

enum EvidenceType {
  id_front
  id_back
  selfie
  liveness_frame
  audit_pdf
}

model ManualReviewNote {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionId String   @map("session_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  decision  String?  // approved | rejected | recapture
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  session VerificationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("manual_review_notes")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String?  @map("tenant_id") @db.ObjectId
  sessionId String?  @map("session_id") @db.ObjectId
  actorType ActorType @map("actor_type")
  actorId   String?  @map("actor_id")
  action    String
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  metadata  Json?
  riskEvent Boolean  @default(false) @map("risk_event")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, createdAt])
  @@index([sessionId])
  @@map("audit_logs")
}

enum ActorType {
  system
  tenant_user
  admin
  api
}

model WebhookDelivery {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  eventUid     String   @unique @map("event_uid")
  tenantId     String   @map("tenant_id") @db.ObjectId
  sessionId    String?  @map("session_id") @db.ObjectId
  event        String
  payload      Json
  url          String
  status       String   @default("pending") // pending|delivered|failed|exhausted
  attempts     Int      @default(0)
  lastStatusCode Int?   @map("last_status_code")
  lastError    String?  @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at")
  deliveredAt  DateTime? @map("delivered_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model JobQueue {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  payload   Json
  status    String   @default("pending") // pending|running|done|failed
  attempts  Int      @default(0)
  maxAttempts Int    @default(5) @map("max_attempts")
  runAfter  DateTime @default(now()) @map("run_after")
  lockedBy  String?  @map("locked_by")
  lockedAt  DateTime? @map("locked_at")
  lastError String?  @map("last_error")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, runAfter])
  @@map("job_queue")
}

// Shared fixed-window rate-limit counters — one document per
// limiter+key+window so the cap holds across ALL API processes/Lambda
// containers. Expired windows are swept by the worker's retention job.
// The composite key doubles as the document _id.
model RateLimitCounter {
  key          String   @id @map("_id") // "<limiter>:<identifier>:<windowBucket>"
  count        Int      @default(0)
  windowEndsAt DateTime @map("window_ends_at")

  @@index([windowEndsAt])
  @@map("rate_limit_counters")
}
